---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCurrentSite } from "../config/sites";
import { getNavigation } from "../config/navigation";

const site = getCurrentSite();
const nav = getNavigation(site.id);
const page = Astro.url.pathname;
---

<BaseLayout
  title={`Pagina niet gevonden — ${site.brandName}`}
  description="Deze pagina bestaat niet of is verplaatst."
  robots="noindex,follow"
>
  <section class="section">
    <div class="container-base max-w-prose text-center">
      <p class="text-6xl font-extrabold text-brand">404</p>
      <h1 class="mt-4 text-3xl font-extrabold text-ink">Pagina niet gevonden</h1>
      <p class="mt-3 lede">
        De pagina die u zoekt bestaat niet (meer). Gebruik het menu hieronder of neem direct contact op.
      </p>

      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={site.phoneHref}
          class="btn btn-primary"
          data-event="phone_click"
          data-site={site.id}
          data-page={page}
        >
          Bel {site.phone}
        </a>
        <a href="/" class="btn btn-ghost">Naar de homepage</a>
      </div>

      <nav aria-label="Snelkoppelingen" class="mt-8">
        <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-brand hover:underline">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>
