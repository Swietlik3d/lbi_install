---
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SafetyAlert from "../components/SafetyAlert.astro";
import ContactBlock from "../components/ContactBlock.astro";
import ContactForm from "../components/ContactForm.astro";
import SectionRenderer from "../components/SectionRenderer.astro";
import FAQ from "../components/FAQ.astro";
import InternalLinks from "../components/InternalLinks.astro";
import { getCurrentSite } from "../config/sites";
import type { CollectionEntry } from "astro:content";

type PageData = CollectionEntry<"pages">["data"];

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  page: PageData;
  schemaNodes?: Array<Record<string, unknown> | null>;
  breadcrumbs?: Crumb[];
}

const { page, schemaNodes = [], breadcrumbs = [] } = Astro.props;
const site = getCurrentSite();
const hasBody = Astro.slots.has("default");
const twoCol = site.enableContactForm;
---

<BaseLayout
  title={page.meta_title}
  description={page.meta_description}
  schemaNodes={schemaNodes}
>
  <Breadcrumbs items={breadcrumbs} />

  {page.safety_alert && (
    <div class="container-base pt-10">
      <SafetyAlert />
    </div>
  )}

  <Hero h1={page.h1} hero={{ ...page.hero, showCallButtons: false }} />
  <section class="section">
    <div class="container-base">
      <div class:list={["grid gap-8", twoCol ? "lg:grid-cols-2" : "max-w-xl"]}>
        <ContactBlock />
        {twoCol && <ContactForm />}
      </div>
    </div>
  </section>

  <SectionRenderer sections={page.sections} />

  {hasBody && (
    <div class="section pt-0">
      <div class="container-base">
        <div class="rich-text">
          <slot />
        </div>
      </div>
    </div>
  )}

  <FAQ faqs={page.faqs} />
  {site.id !== "lbi" && <InternalLinks links={page.internal_links} />}
</BaseLayout>
