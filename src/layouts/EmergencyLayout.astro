---
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SafetyAlert from "../components/SafetyAlert.astro";
import TrustBadges from "../components/TrustBadges.astro";
import SectionRenderer from "../components/SectionRenderer.astro";
import FAQ from "../components/FAQ.astro";
import InternalLinks from "../components/InternalLinks.astro";
import CTASection from "../components/CTASection.astro";
import type { CollectionEntry } from "astro:content";

type PageData = CollectionEntry<"pages">["data"];

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  page: PageData;
  schemaNodes?: Array<Record<string, unknown> | null>;
  breadcrumbs?: Crumb[];
}

const { page, schemaNodes = [], breadcrumbs = [] } = Astro.props;
const hasBody = Astro.slots.has("default");
---

<BaseLayout
  title={page.meta_title}
  description={page.meta_description}
  schemaNodes={schemaNodes}
>
  <Breadcrumbs items={breadcrumbs} />

  {/* Safety block sits ABOVE all commercial content when enabled (gas pages). */}
  {page.safety_alert && (
    <div class="container-base pt-10">
      <SafetyAlert />
    </div>
  )}

  <Hero h1={page.h1} hero={page.hero} variant="emergency" />
  <TrustBadges items={[
    { label: "Onderdeel van LBI Installaties", note: "Rechtstreeks contact met Luc." },
    { label: "Duidelijk overleg", note: "Werkzaamheden en vervolgstappen vooraf bespreken." },
    { label: "Helmond en omgeving", note: "Bel voor de actuele beschikbaarheid." },
    { label: "Praktische aanpak", note: "Foto's helpen bij een eerste inschatting." },
  ]} />
  <SectionRenderer sections={page.sections} />

  {hasBody && (
    <div class="section">
      <div class="container-base">
        <div class="rich-text">
          <slot />
        </div>
      </div>
    </div>
  )}

  <FAQ faqs={page.faqs} />
  <InternalLinks links={page.internal_links} />
  <CTASection ctaPrimary={page.cta_primary} ctaSecondary={page.cta_secondary} />
</BaseLayout>
