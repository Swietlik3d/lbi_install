---
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SectionRenderer from "../components/SectionRenderer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ReviewCard from "../components/ReviewCard.astro";
import FAQ from "../components/FAQ.astro";
import InternalLinks from "../components/InternalLinks.astro";
import CTASection from "../components/CTASection.astro";
import type { CollectionEntry } from "astro:content";

type PageData = CollectionEntry<"pages">["data"];

interface Crumb {
  name: string;
  href: string;
}

interface ProjectItem {
  title: string;
  summary?: string;
  cover?: string;
  coverAlt?: string;
  category?: string;
  location?: string;
}

interface ReviewItem {
  author: string;
  quote: string;
  rating?: number;
  service?: string;
  source?: string;
}

interface Props {
  page: PageData;
  schemaNodes?: Array<Record<string, unknown> | null>;
  breadcrumbs?: Crumb[];
  /** When provided (projects page), renders a grid or an empty state. */
  projectItems?: ProjectItem[];
  /** When provided (reviews page), renders a grid or an empty state. */
  reviewItems?: ReviewItem[];
}

const { page, schemaNodes = [], breadcrumbs = [], projectItems, reviewItems } = Astro.props;
const hasBody = Astro.slots.has("default");
---

<BaseLayout
  title={page.meta_title}
  description={page.meta_description}
  schemaNodes={schemaNodes}
>
  <Breadcrumbs items={breadcrumbs} />
  <Hero h1={page.h1} hero={page.hero} />
  <SectionRenderer sections={page.sections} />

  {hasBody && (
    <div class="section">
      <div class="container-base">
        <div class="rich-text">
          <slot />
        </div>
      </div>
    </div>
  )}

  {projectItems && (
    <section class="section">
      <div class="container-base">
        {projectItems.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projectItems.map((p) => (
              <ProjectCard
                title={p.title}
                summary={p.summary}
                cover={p.cover}
                coverAlt={p.coverAlt}
                category={p.category}
                location={p.location}
              />
            ))}
          </div>
        ) : (
          <div class="card p-8 text-center text-muted">
            <p class="font-semibold text-ink">Projecten worden binnenkort toegevoegd.</p>
            <p class="mt-2 text-sm">
              {/* TODO: voeg echte projecten toe via de CMS-collectie "Projecten". */}
              Wilt u voorbeelden van eerder werk? Vraag ze gerust op via de telefoon of WhatsApp.
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  {reviewItems && (
    <section class="section">
      <div class="container-base">
        {reviewItems.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {reviewItems.map((r) => (
              <ReviewCard
                author={r.author}
                quote={r.quote}
                rating={r.rating}
                service={r.service}
                source={r.source}
              />
            ))}
          </div>
        ) : (
          <div class="card p-8 text-center text-muted">
            <p class="font-semibold text-ink">Er zijn nog geen reviews gepubliceerd.</p>
            <p class="mt-2 text-sm">
              {/* TODO: voeg alleen ECHTE, verifieerbare reviews toe via de CMS-collectie "Reviews". */}
              We plaatsen hier uitsluitend echte ervaringen van klanten.
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  <FAQ faqs={page.faqs} />
  <InternalLinks links={page.internal_links} />
  <CTASection ctaPrimary={page.cta_primary} ctaSecondary={page.cta_secondary} />
</BaseLayout>
