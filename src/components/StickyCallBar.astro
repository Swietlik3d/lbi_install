---
import { getCurrentSite } from "../config/sites";

const site = getCurrentSite();
const page = Astro.url.pathname;
const lbi = site.id === "lbi";
const gas = site.id === "gas";
---

<!-- Mobile-only sticky conversion bar. Hidden on md+ where the header CTA is visible. -->
<div
  class:list={[
    "fixed inset-x-0 bottom-0 z-50 border-t backdrop-blur md:hidden",
    lbi ? "border-white/10 bg-[#090909]/95" : "border-slate-200 bg-white/95",
  ]}
  role="region"
  aria-label="Snel contact"
>
  <div class="grid grid-cols-2 gap-px">
    <a
      href={gas ? "tel:08009009" : site.phoneHref}
      class="flex items-center justify-center gap-2 bg-brand py-3 text-sm font-bold text-brand-ink no-underline"
      data-event="phone_click"
      data-site={site.id}
      data-page={page}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
        <path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"/>
      </svg>
      {gas ? "Gaslucht? Bel buiten" : "Bel direct"}
    </a>
    <a
      href={gas ? "/veiligheid-bij-gaslucht/" : site.whatsappHref}
      class:list={["flex items-center justify-center gap-2 py-3 text-sm font-bold no-underline", gas ? "bg-surface text-ink" : "bg-[#25D366] text-white"]}
      data-event={gas ? undefined : "whatsapp_click"}
      data-site={site.id}
      data-page={page}
      rel="noopener"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class:list={["h-5 w-5", gas && "hidden"]} fill="currentColor">
        <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.6 14.2c-.24.67-1.4 1.28-1.93 1.32-.5.05-1.13.07-1.83-.11a16.5 16.5 0 0 1-1.66-.61 13 13 0 0 1-5-4.42c-.37-.5-1.1-1.67-1.1-3.18s.8-2.26 1.08-2.57a1.13 1.13 0 0 1 .82-.38h.59c.19 0 .44-.07.69.53l.85 2.06c.07.16.12.35.01.55l-.32.5c-.1.13-.2.27-.32.4-.13.13-.27.27-.12.53.16.26.7 1.15 1.5 1.86 1.04.93 1.9 1.21 2.16 1.34.26.13.42.11.58-.07l.82-1c.2-.26.4-.2.66-.11l1.9.92c.27.13.45.19.51.3.07.1.07.6-.17 1.27Z"/>
      </svg>
      {gas ? "Veiligheidsadvies" : "WhatsApp"}
    </a>
  </div>
</div>
<!-- Spacer so fixed bar never covers footer content on mobile. -->
<div class="h-14 md:hidden" aria-hidden="true"></div>
