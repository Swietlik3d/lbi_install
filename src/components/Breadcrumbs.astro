---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav aria-label="Kruimelpad" class="border-b border-slate-100 bg-white">
      <ol class="container-base flex flex-wrap items-center gap-1 py-3 text-sm text-muted">
        {items.map((item, i) => {
          const isLast = i === items.length - 1;
          return (
            <li class="flex items-center gap-1">
              {isLast ? (
                <span aria-current="page" class="font-medium text-ink">
                  {item.name}
                </span>
              ) : (
                <a href={item.href} class="hover:text-brand">
                  {item.name}
                </a>
              )}
              {!isLast && (
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                </svg>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
