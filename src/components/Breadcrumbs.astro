---
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <div class="container">
        <ol>
          {items.map((item, index) => (
            <li>
              {index + 1 === items.length ? (
                <span aria-current="page">{item.label}</span>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<style>
  .breadcrumbs {
    padding: 18px 0 0;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    color: var(--color-muted);
    font-size: 0.86rem;
    font-weight: 750;
  }

  li + li::before {
    margin-right: 8px;
    color: color-mix(in srgb, var(--color-muted) 55%, white);
    content: "/";
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
