---
interface Props {
  author: string;
  quote: string;
  rating?: number;
  service?: string;
  source?: string;
}

const { author, quote, rating, service, source } = Astro.props;
const stars = typeof rating === "number" ? Math.max(0, Math.min(5, Math.round(rating))) : 0;
---

<figure class="card flex h-full flex-col p-6">
  {stars > 0 && (
    <div class="flex gap-0.5 text-amber-500" aria-label={`${stars} van 5 sterren`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill={i < stars ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linejoin="round" d="M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.9 6.7 19.2l1-5.8-4.2-4.1 5.9-.9z" />
        </svg>
      ))}
    </div>
  )}
  <blockquote class="mt-3 flex-1 text-ink">
    <p class="leading-relaxed">&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-4 text-sm">
    <span class="font-bold text-ink">{author}</span>
    {service && <span class="text-muted"> · {service}</span>}
    {source && <span class="block text-xs text-muted">via {source}</span>}
  </figcaption>
</figure>
