---
import { getCurrentSite } from "../config/sites";

interface Cta {
  label: string;
  href: string;
  style?: "primary" | "ghost" | "whatsapp" | "accent";
  event?: string;
}

interface Props {
  title?: string;
  text?: string;
  ctaPrimary?: Cta;
  ctaSecondary?: Cta;
}

const { title, text, ctaPrimary, ctaSecondary } = Astro.props;
const site = getCurrentSite();
const page = Astro.url.pathname;
const isLbi = site.id === "lbi";
const gas = site.id === "gas";

const primary: Cta = ctaPrimary ?? {
  label: `Bel ${site.phone}`,
  href: site.phoneHref,
  style: "primary",
  event: "phone_click",
};
const secondary: Cta = ctaSecondary ?? {
  label: "WhatsApp",
  href: site.whatsappHref,
  style: "whatsapp",
  event: "whatsapp_click",
};

const styleClass: Record<string, string> = {
  primary: "btn-primary",
  ghost: "btn-ghost",
  whatsapp: "btn-wa",
  accent: "btn-accent",
};
---

<section class="section">
  <div class="container-base">
    <div class="rounded-2xl bg-brand px-6 py-10 text-brand-ink sm:px-10 sm:py-12">
      <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
        <div>
          <h2 class="text-2xl font-extrabold sm:text-3xl">
            {title ?? (gas ? "Is de situatie veilig? Bespreek het vervolg." : isLbi ? "Uw klus bespreken?" : `Hulp nodig in ${site.area.split(" ")[0]}?`)}
          </h2>
          <p class="mt-2 max-w-prose text-brand-ink/90">
            {text ?? (gas ? "Voor controle en herstel nadat de situatie veilig is. Bij gaslucht: ga naar buiten en bel 0800-9009. Bij direct gevaar: 112." : isLbi
              ? "Bel of stuur een bericht. We bespreken uw vraag en bepalen samen een passende vervolgstap."
              : "Bel voor beschikbaarheid of stuur foto's voor een eerste inschatting. We bespreken wat nodig is en maken duidelijke afspraken.")}
          </p>
        </div>
        <div class="flex w-full flex-col flex-wrap gap-3 sm:w-auto sm:max-w-xl sm:flex-row">
          <a
            href={primary.href}
            class:list={["btn bg-white text-brand hover:bg-white/90", primary.style === "whatsapp" && styleClass.whatsapp]}
            data-event={primary.event}
            data-site={site.id}
            data-page={page}
            rel={primary.href.startsWith("http") ? "noopener" : undefined}
          >
            {primary.label}
          </a>
          <a
            href={secondary.href}
            class:list={["btn", secondary.style === "whatsapp" ? "btn-wa" : "bg-brand-dark text-brand-ink hover:brightness-110"]}
            data-event={secondary.event}
            data-site={site.id}
            data-page={page}
            rel={secondary.href.startsWith("http") ? "noopener" : undefined}
          >
            {secondary.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
