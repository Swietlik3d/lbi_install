---
import { jsonLdGraph } from "../config/schema";

interface Props {
  nodes: Array<Record<string, unknown> | null>;
}

const { nodes } = Astro.props;
const json = jsonLdGraph(nodes);
// Escape "<" so a stray sequence can never break out of the script element.
const safe = json.replace(/</g, "\\u003c");
---

{nodes.some(Boolean) && <script type="application/ld+json" set:html={safe} />}
