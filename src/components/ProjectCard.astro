---
interface Props {
  title: string;
  summary?: string;
  cover?: string;
  coverAlt?: string;
  category?: string;
  location?: string;
  href?: string;
}

const { title, summary, cover, coverAlt, category, location, href } = Astro.props;
const Wrapper = href ? "a" : "div";
const wrapperProps = href ? { href, class: "no-underline" } : {};
---

<article class="card group flex h-full flex-col overflow-hidden">
  <div class="aspect-[4/3] w-full overflow-hidden bg-slate-100">
    {cover ? (
      <img
        src={cover}
        alt={coverAlt ?? title}
        width="600"
        height="450"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition group-hover:scale-[1.02]"
      />
    ) : (
      <div class="grid h-full w-full place-items-center bg-brand-light text-brand">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16l5-5 4 4 3-3 6 6M3 5h18v14H3z" />
        </svg>
        <span class="sr-only">Projectfoto volgt</span>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    {(category || location) && (
      <p class="text-xs font-semibold uppercase tracking-wide text-brand">
        {[category, location].filter(Boolean).join(" · ")}
      </p>
    )}
    <Wrapper {...wrapperProps}>
      <h3 class="mt-1 text-lg font-bold text-ink group-hover:text-brand">{title}</h3>
    </Wrapper>
    {summary && <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>}
  </div>
</article>
