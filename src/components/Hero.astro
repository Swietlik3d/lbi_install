---
import { getCurrentSite } from "../config/sites";

interface HeroData {
  kicker?: string;
  title?: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  showCallButtons?: boolean;
}

interface Props {
  h1: string;
  hero?: HeroData;
  variant?: "default" | "emergency";
}

const { h1, hero, variant = "default" } = Astro.props;
const site = getCurrentSite();
const page = Astro.url.pathname;
const showButtons = hero?.showCallButtons ?? true;
const kicker = hero?.kicker ?? (variant === "emergency" ? "Snel een vakman nodig?" : site.tagline);
const subtitle = hero?.subtitle;
const hasImage = Boolean(hero?.image);
---

<section
  class:list={[
    "relative overflow-hidden",
    variant === "emergency" ? "bg-brand text-brand-ink" : "bg-surface text-ink",
  ]}
>
  <div class="container-base grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-2 lg:py-20">
    <div>
      {kicker && (
        <p
          class:list={[
            "text-sm font-semibold uppercase tracking-wide",
            variant === "emergency" ? "text-brand-ink/80" : "text-brand",
          ]}
        >
          {kicker}
        </p>
      )}
      <h1 class="mt-3 text-3xl leading-tight sm:text-4xl lg:text-5xl">{h1}</h1>
      {subtitle && (
        <p
          class:list={[
            "mt-4 max-w-prose text-lg leading-relaxed",
            variant === "emergency" ? "text-brand-ink/90" : "text-muted",
          ]}
        >
          {subtitle}
        </p>
      )}

      {showButtons && (
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.phoneHref}
            class:list={[
              "btn text-base",
              variant === "emergency" ? "bg-white text-brand hover:bg-white/90" : "btn-primary",
            ]}
            data-event="phone_click"
            data-site={site.id}
            data-page={page}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"/>
            </svg>
            Bel direct {site.phone}
          </a>
          <a
            href={site.whatsappHref}
            class="btn btn-wa text-base"
            data-event="whatsapp_click"
            data-site={site.id}
            data-page={page}
            rel="noopener"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.6 14.2c-.24.67-1.4 1.28-1.93 1.32-.5.05-1.13.07-1.83-.11a16.5 16.5 0 0 1-1.66-.61 13 13 0 0 1-5-4.42c-.37-.5-1.1-1.67-1.1-3.18s.8-2.26 1.08-2.57a1.13 1.13 0 0 1 .82-.38h.59c.19 0 .44-.07.69.53l.85 2.06c.07.16.12.35.01.55l-.32.5c-.1.13-.2.27-.32.4-.13.13-.27.27-.12.53.16.26.7 1.15 1.5 1.86 1.04.93 1.9 1.21 2.16 1.34.26.13.42.11.58-.07l.82-1c.2-.26.4-.2.66-.11l1.9.92c.27.13.45.19.51.3.07.1.07.6-.17 1.27Z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      )}
    </div>

    {hasImage && (
      <div class="overflow-hidden rounded-2xl bg-slate-100 shadow-card">
        <img
          src={hero!.image}
          alt={hero?.imageAlt ?? ""}
          width="800"
          height="600"
          class="aspect-[4/3] h-auto w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
  </div>
</section>
