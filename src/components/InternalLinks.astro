---
interface LinkItem {
  label: string;
  href: string;
  description?: string;
}

interface Props {
  links: LinkItem[];
  title?: string;
}

const { links, title = "Bekijk ook" } = Astro.props;
---

{
  links.length > 0 && (
    <section class="section">
      <div class="container-base">
        <h2 class="text-xl font-extrabold text-ink">{title}</h2>
        <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="card flex h-full flex-col p-5 no-underline transition hover:border-brand hover:shadow-lg"
                rel={link.href.startsWith("http") ? "noopener" : undefined}
              >
                <span class="font-semibold text-brand">{link.label}</span>
                {link.description && <span class="mt-1 text-sm text-muted">{link.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
