---
import { getCurrentSite } from "../config/sites";

const site = getCurrentSite();
const page = Astro.url.pathname;

// Static-friendly. The form is OFF by default (enableContactForm: false in
// sites.json) so phone + WhatsApp stay the primary conversion paths.
// When enabled, pick a provider in sites.json: "netlify" | "formspree" | "custom".
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";
const provider = site.formProvider;

const action =
  provider === "formspree" || provider === "custom" ? endpoint || undefined : undefined;
const method = provider === "none" ? undefined : "POST";
const isNetlify = provider === "netlify";
---

{
  site.enableContactForm && (
    <form
      class="card space-y-4 p-6 sm:p-8"
      name="contact"
      method={method}
      action={action}
      data-netlify={isNetlify ? "true" : undefined}
      netlify-honeypot={isNetlify ? "bot-field" : undefined}
    >
      {isNetlify && <input type="hidden" name="form-name" value="contact" />}
      <p class="hidden">
        <label>Laat dit veld leeg: <input name="bot-field" /></label>
      </p>

      <div>
        <label for="cf-name" class="block text-sm font-semibold text-ink">Naam</label>
        <input
          id="cf-name"
          name="naam"
          type="text"
          required
          autocomplete="name"
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus-visible:border-brand"
        />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="cf-phone" class="block text-sm font-semibold text-ink">Telefoon</label>
          <input
            id="cf-phone"
            name="telefoon"
            type="tel"
            autocomplete="tel"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus-visible:border-brand"
          />
        </div>
        <div>
          <label for="cf-email" class="block text-sm font-semibold text-ink">E-mail</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            autocomplete="email"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus-visible:border-brand"
          />
        </div>
      </div>

      <div>
        <label for="cf-message" class="block text-sm font-semibold text-ink">Uw vraag</label>
        <textarea
          id="cf-message"
          name="bericht"
          rows="5"
          required
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus-visible:border-brand"
        />
      </div>

      <button
        type="submit"
        class="btn btn-primary w-full sm:w-auto"
        data-event="contact_submit"
        data-site={site.id}
        data-page={page}
      >
        Verstuur bericht
      </button>
      <p class="text-xs text-muted">
        Liever direct contact? Bel <a href={site.phoneHref} class="text-brand">{site.phone}</a> of
        stuur een <a href={site.whatsappHref} class="text-brand" rel="noopener">WhatsApp</a>.
      </p>
    </form>
  )
}
