---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
}

const { faqs, title = "Veelgestelde vragen" } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="section">
      <div class="container-base max-w-prose">
        <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">{title}</h2>
        <div class="mt-6 divide-y divide-slate-200 border-t border-slate-200">
          {faqs.map((item) => (
            <details class="group py-2">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-left font-semibold text-ink">
                <span>{item.question}</span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="h-5 w-5 shrink-0 text-brand transition group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <div class="pb-4 pr-9 leading-relaxed text-muted">{item.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
