---
interface Section {
  id?: string;
  heading?: string;
  body?: string;
  bullets?: string[];
  image?: string;
  imageAlt?: string;
  layout?: "text" | "cards" | "split" | "steps";
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;

function paragraphs(body?: string): string[] {
  if (!body) return [];
  return body
    .split(/\n{2,}/)
    .map((p) => p.trim())
    .filter(Boolean);
}
---

{
  sections.map((section) => {
    const layout = section.layout ?? "text";
    const paras = paragraphs(section.body);
    return (
      <section class="section" id={section.id}>
        <div class="container-base">
          {layout === "split" && section.image ? (
            <div class="grid items-center gap-8 lg:grid-cols-2">
              <div class="max-w-prose">
                {section.heading && (
                  <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">{section.heading}</h2>
                )}
                {paras.map((p) => (
                  <p class="mt-4 leading-relaxed text-muted">{p}</p>
                ))}
                {section.bullets && section.bullets.length > 0 && (
                  <ul class="mt-4 space-y-2">
                    {section.bullets.map((b) => (
                      <li class="flex items-start gap-2 text-ink">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div class="overflow-hidden rounded-2xl bg-slate-100 shadow-card">
                <img
                  src={section.image}
                  alt={section.imageAlt ?? ""}
                  width="700"
                  height="525"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] h-auto w-full object-cover"
                />
              </div>
            </div>
          ) : (
            <div class="max-w-prose">
              {section.heading && (
                <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">{section.heading}</h2>
              )}
              {paras.map((p) => (
                <p class="mt-4 leading-relaxed text-muted">{p}</p>
              ))}

              {layout === "steps" && section.bullets && section.bullets.length > 0 && (
                <ol class="mt-6 space-y-4">
                  {section.bullets.map((b, i) => (
                    <li class="flex gap-4">
                      <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand font-bold text-brand-ink">
                        {i + 1}
                      </span>
                      <span class="pt-1 text-ink">{b}</span>
                    </li>
                  ))}
                </ol>
              )}

              {layout === "cards" && section.bullets && section.bullets.length > 0 && (
                <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                  {section.bullets.map((b) => (
                    <li class="card p-5 text-ink">{b}</li>
                  ))}
                </ul>
              )}

              {(layout === "text" || !layout) && section.bullets && section.bullets.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {section.bullets.map((b) => (
                    <li class="flex items-start gap-2 text-ink">
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>
      </section>
    );
  })
}
