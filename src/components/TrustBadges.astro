---
import { getGlobalSettings } from "../lib/settings";

interface Badge {
  label: string;
  note?: string;
}

interface Props {
  items?: Badge[];
  title?: string;
}

// Default value-props only. These are editable (see Global settings in the CMS)
// and contain NO certifications, ratings or availability claims — confirm with
// the business owner before presenting any of these as guarantees.
const DEFAULT_BADGES: Badge[] = [
  { label: "Vaste contactpersoon", note: "U weet met wie u te maken heeft." },
  { label: "Duidelijke prijsafspraak vooraf", note: "Geen verrassingen achteraf." },
  { label: "Lokaal in Helmond e.o.", note: "Snel ter plaatse in de regio." },
  { label: "Net en opgeruimd werk", note: "We laten het schoon achter." },
];

const { items, title } = Astro.props;
const settings = await getGlobalSettings();
const fromCms = settings?.trust_badges ?? [];
const badges =
  items && items.length > 0 ? items : fromCms.length > 0 ? fromCms : DEFAULT_BADGES;
---

<section class="border-y border-slate-200 bg-surface">
  <div class="container-base py-8">
    {title && <h2 class="mb-5 text-center text-sm font-bold uppercase tracking-wide text-muted">{title}</h2>}
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {badges.map((b) => (
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-light text-brand" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </span>
          <span>
            <span class="block font-semibold text-ink">{b.label}</span>
            {b.note && <span class="block text-sm text-muted">{b.note}</span>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
