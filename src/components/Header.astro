---
import { getCurrentSite } from "../config/sites";
import { getNavigation } from "../config/navigation";

const site = getCurrentSite();
const nav = getNavigation(site.id);
const page = Astro.url.pathname;
const lbi = site.id === "lbi";
const gas = site.id === "gas";

function isActive(href: string): boolean {
  if (href === "/") return page === "/";
  if (href.includes("#")) return false;
  return page === href || page.startsWith(href);
}
---

<header
  class:list={[
    "sticky top-0 z-40 backdrop-blur",
    lbi
      ? "lbi-site-header"
      : gas
        ? "gas-site-header"
        : "border-b border-slate-200 bg-white/95",
  ]}
>
  <div class:list={[lbi ? "lbi-header-shell" : gas ? "gas-header-shell" : "container-base", "flex items-center justify-between gap-4 py-3"]}>
    <a href="/" class:list={[lbi ? "lbi-brand" : gas ? "gas-brand" : "flex items-center gap-3", "no-underline"]} aria-label={`${site.brandName} — home`}>
      {lbi ? (
        <>
          <span class="lbi-brand__mark" aria-hidden="true">
            <span>LBI</span>
          </span>
          <span class="lbi-brand__text">
            <span>Installaties</span>
            <strong>Helmond</strong>
          </span>
        </>
      ) : gas ? (
        <>
          <span class="gas-brand__mark" aria-hidden="true">LBI</span>
          <span class="gas-brand__divider" aria-hidden="true"></span>
          <span class="gas-brand__text">Installaties<br />Helmond</span>
        </>
      ) : (
        <>
          <span
            class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand text-base font-extrabold text-brand-ink"
            aria-hidden="true"
          >
            {site.brandName.slice(0, 2).toUpperCase()}
          </span>
          <span class="leading-tight">
            <span class="block text-base font-extrabold text-ink sm:text-lg">{site.brandName}</span>
            {site.subtitle && <span class="block text-xs text-muted">{site.subtitle}</span>}
          </span>
        </>
      )}
    </a>

    <!-- Desktop navigation -->
    {!gas && (
    <nav aria-label="Hoofdmenu" class:list={["hidden items-center md:flex", lbi ? "gap-7" : "gap-1"]}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "no-underline transition",
              lbi
                ? "lbi-nav-link"
                : "rounded-md px-3 py-2 text-sm font-medium",
              isActive(item.href)
                ? lbi
                  ? "is-active"
                  : "text-brand"
                : lbi
                  ? ""
                  : "text-ink hover:bg-surface hover:text-brand",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    )}

    <div class:list={[gas ? "gas-header-actions" : "flex items-center gap-2"]}>
      <a
        href={site.phoneHref}
        class:list={[
          "hidden sm:inline-flex",
          lbi ? "lbi-header-phone" : gas ? "gas-header-phone" : "btn btn-primary px-4 py-2 text-sm",
        ]}
        data-event="phone_click"
        data-site={site.id}
        data-page={page}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
          <path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"/>
        </svg>
        <span>{site.phone}</span>
      </a>

      {gas && (
        <a
          href={site.phoneHref}
          class="gas-header-button hidden sm:inline-flex"
          data-event="phone_click"
          data-site={site.id}
          data-page={page}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z" />
          </svg>
          Bel direct
        </a>
      )}

      <!-- Mobile menu: JS-free disclosure -->
      <details class="relative md:hidden">
        <summary
          class:list={[
            "cursor-pointer list-none",
            lbi ? "lbi-mobile-summary" : gas ? "gas-mobile-summary" : "btn btn-ghost px-3 py-2",
          ]}
          aria-label="Menu openen of sluiten"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <span class="sr-only">Menu</span>
        </summary>
        <nav
          aria-label="Mobiel menu"
          class:list={[
            "absolute right-0 top-full mt-2 w-64 rounded-xl p-2 shadow-card",
            lbi ? "border border-white/15 bg-[#151515]" : "border border-slate-200 bg-white",
          ]}
        >
          {gas ? (
            <>
              <a
                href={site.phoneHref}
                class="btn btn-primary w-full text-sm"
                data-event="phone_click"
                data-site={site.id}
                data-page={page}
              >
                Bel direct {site.phone}
              </a>
              <a href="/contact/" class="mt-2 block rounded-md px-3 py-2 text-sm font-medium no-underline text-ink hover:bg-surface">
                Vraag hulp aan
              </a>
            </>
          ) : (
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded-md px-3 py-2 text-sm font-medium no-underline",
                  isActive(item.href)
                    ? lbi ? "bg-white/10 text-brand" : "bg-surface text-brand"
                    : lbi ? "text-white hover:bg-white/10" : "text-ink hover:bg-surface",
                ]}
              >
                {item.label}
              </a>
            ))
          )}
          {!gas && (
          <a
            href={site.phoneHref}
            class:list={[
              "mt-2 w-full",
              lbi ? "lbi-header-phone justify-center" : "btn btn-primary text-sm",
            ]}
            data-event="phone_click"
            data-site={site.id}
            data-page={page}
          >
            Bel {site.phone}
          </a>
          )}
        </nav>
      </details>
    </div>
  </div>
</header>
