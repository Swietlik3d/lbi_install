---
import { getCurrentSite, isMicrosite, isPlaceholder, LBI_MAIN_URL } from "../config/sites";
import { getNavigation } from "../config/navigation";
import { getGlobalSettings } from "../lib/settings";

interface Props {
  footerNote?: string;
}

const { footerNote } = Astro.props;
const settings = await getGlobalSettings();
const note = footerNote ?? settings?.footer_note;
const site = getCurrentSite();
const micro = isMicrosite(site);
const nav = getNavigation(site.id);
const page = Astro.url.pathname;
const year = new Date().getFullYear();
const lbi = site.id === "lbi";
const gas = site.id === "gas";
const showKvk = !isPlaceholder(site.kvk);
const showBtw = !isPlaceholder(site.btw);

// Privacy lives on the main LBI site; microsites link out to it.
const privacyHref = micro ? `${LBI_MAIN_URL}/privacy-cookies/` : "/privacy-cookies/";
---

<footer
  class:list={[
    lbi
      ? "border-t border-white/10 bg-[#070707] text-white"
      : gas
        ? "gas-footer"
      : "mt-16 border-t border-slate-200 bg-surface",
  ]}
>
  {gas ? (
    <>
      <div class="gas-shell gas-footer__grid">
        <div>
          <a href="/" class="gas-brand gas-footer__brand" aria-label={`${site.parentBrand} — home`}>
            <span class="gas-brand__mark" aria-hidden="true">LBI</span>
            <span class="gas-brand__divider" aria-hidden="true"></span>
            <span class="gas-brand__text">Installaties<br />Helmond</span>
          </a>
          <p>{site.brandName}. <a href={LBI_MAIN_URL}>Onderdeel van LBI Installaties</a>.</p>
          <p>Gasleiding aansluiten, verleggen, controleren en herstellen wanneer de situatie veilig is.</p>
        </div>
        <div>
          <h2>Niet-acute vragen aan LBI</h2>
          <ul>
            <li><a href={site.phoneHref} data-event="phone_click" data-site={site.id} data-page={page}>{site.phone}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>{site.area}</li>
          </ul>
        </div>
        <div>
          <h2>Gaslucht?</h2>
          <p>Ga naar buiten. Bel op veilige afstand <a href="tel:08009009">0800-9009</a>.</p>
          <p>Bij direct gevaar: <a href="tel:112">112</a>.</p>
        </div>
        <div>
          <h2>Verder lezen</h2>
          <ul>{nav.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </div>
      </div>
      <div class="gas-footer__bottom">
        <p>&copy; {year} LBI Installaties Helmond</p>
        {showKvk && <p>KVK: {site.kvk}</p>}
        {showBtw && <p>BTW: {site.btw}</p>}
        <a href={privacyHref}>Privacy &amp; cookies</a>
      </div>
    </>
  ) : (
  <>
  <div class="container-base grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class:list={["text-lg font-extrabold", lbi ? "text-white" : "text-ink"]}>{site.brandName}</p>
      {micro && (
        <p class="mt-1 text-sm text-muted">
          <a href={`${LBI_MAIN_URL}/`} class="font-medium text-brand">Onderdeel van {site.parentBrand}</a>
        </p>
      )}
      <p class:list={["mt-3 max-w-prose text-sm", lbi ? "text-white/65" : "text-muted"]}>{site.tagline}</p>
      <p class:list={["mt-3 text-sm", lbi ? "text-white/65" : "text-muted"]}>Werkgebied: {site.area}</p>
    </div>

    <div>
      <h2 class:list={["text-sm font-bold uppercase tracking-wide", lbi ? "text-white" : "text-ink"]}>Contact</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a
            href={site.phoneHref}
            class="font-medium text-brand"
            data-event="phone_click"
            data-site={site.id}
            data-page={page}
          >
            {site.phone}
          </a>
        </li>
        <li>
          <a
            href={site.whatsappHref}
            class="font-medium text-brand"
            data-event="whatsapp_click"
            data-site={site.id}
            data-page={page}
            rel="noopener"
          >
            WhatsApp
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class:list={[lbi ? "text-white/65" : "text-muted", "hover:text-brand"]}>{site.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class:list={["text-sm font-bold uppercase tracking-wide", lbi ? "text-white" : "text-ink"]}>Menu</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a href={item.href} class:list={[lbi ? "text-white/65" : "text-muted", "hover:text-brand"]}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class:list={["text-sm font-bold uppercase tracking-wide", lbi ? "text-white" : "text-ink"]}>
        {micro ? site.parentBrand : "Bedrijf"}
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {micro ? (
          <>
            <li><a href={`${LBI_MAIN_URL}/`} class="text-muted hover:text-brand">Meer over {site.parentBrand}</a></li>
            <li><a href={`${LBI_MAIN_URL}/diensten/`} class="text-muted hover:text-brand">Alle diensten</a></li>
            <li><a href={privacyHref} class="text-muted hover:text-brand">Privacy &amp; cookies</a></li>
          </>
        ) : (
          <>
            <li><a href="/over-lbi/" class:list={[lbi ? "text-white/65" : "text-muted", "hover:text-brand"]}>Over ons</a></li>
            <li><a href="/werkgebied/" class:list={[lbi ? "text-white/65" : "text-muted", "hover:text-brand"]}>Werkgebied</a></li>
            <li><a href={privacyHref} class:list={[lbi ? "text-white/65" : "text-muted", "hover:text-brand"]}>Privacy &amp; cookies</a></li>
          </>
        )}
      </ul>
    </div>
  </div>

  {note && (
    <div class="container-base pb-6">
      <p class:list={["max-w-prose text-xs", lbi ? "text-white/55" : "text-muted"]}>{note}</p>
    </div>
  )}

  <div class:list={[lbi ? "border-t border-white/10" : "border-t border-slate-200"]}>
    <div class:list={["container-base flex flex-col gap-2 py-5 text-xs sm:flex-row sm:items-center sm:justify-between", lbi ? "text-white/55" : "text-muted"]}>
      <p>&copy; {year} {site.legalName}. Alle rechten voorbehouden.</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        {showKvk && <span>KVK: {site.kvk}</span>}
        {showBtw && <span>BTW: {site.btw}</span>}
        <a href={privacyHref} class="hover:text-brand">Privacy &amp; cookies</a>
      </p>
    </div>
  </div>
  </>
  )}
</footer>
