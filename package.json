{
  "name": "lbi-helmond-multisite",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "One codebase, four separately deployable static sites: LBI Installaties + three emergency microsites (Elektra, Lekkage, Gas) in Helmond.",
  "scripts": {
    "dev": "cross-env SITE_ID=lbi astro dev",
    "dev:lbi": "cross-env SITE_ID=lbi astro dev",
    "dev:elektra": "cross-env SITE_ID=elektra astro dev",
    "dev:lekkage": "cross-env SITE_ID=lekkage astro dev",
    "dev:gas": "cross-env SITE_ID=gas astro dev",
    "build": "node scripts/build-all.mjs",
    "build:lbi": "node scripts/build-site.mjs lbi",
    "build:elektra": "node scripts/build-site.mjs elektra",
    "build:lekkage": "node scripts/build-site.mjs lekkage",
    "build:gas": "node scripts/build-site.mjs gas",
    "build:all": "node scripts/build-all.mjs",
    "preview:lbi": "cross-env SITE_ID=lbi astro preview",
    "preview:elektra": "cross-env SITE_ID=elektra astro preview",
    "preview:lekkage": "cross-env SITE_ID=lekkage astro preview",
    "preview:gas": "cross-env SITE_ID=gas astro preview",
    "check": "cross-env SITE_ID=lbi astro check",
    "check:all": "node scripts/check-all.mjs",
    "typecheck": "cross-env SITE_ID=lbi astro check"
  },
  "dependencies": {
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^6.0.2",
    "@types/node": "^20.17.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
