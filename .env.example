# Active site for `astro dev` / `astro check` when not set by the build scripts.
# One of: lbi | elektra | lekkage | gas
SITE_ID=lbi

# Optional: contact-form endpoint used by ContactForm.astro when forms are enabled.
# Leave empty to keep phone + WhatsApp as the only conversion paths.
# Examples:
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Custom:     https://your-endpoint.example/contact
PUBLIC_CONTACT_ENDPOINT=

# Optional analytics. No tracking IDs are hardcoded anywhere in the codebase.
# If you add a tag, wire it in src/components/AnalyticsHook is NOT needed —
# the data-event attributes are emitted regardless; your tag manager reads them.
